<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores a single set of personal AI prompt instructions for each Salesforce user, used by the Advisor Assistant to personalise AI generation.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>User AI Instruction</label>
    <nameField>
        <displayFormat>UAII-{00000}</displayFormat>
        <label>User AI Instruction Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>User AI Instructions</pluralLabel>
    <sharingModel>Private</sharingModel>
</CustomObject>
