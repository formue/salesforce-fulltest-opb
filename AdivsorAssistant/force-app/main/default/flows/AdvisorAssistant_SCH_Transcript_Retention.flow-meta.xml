<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Apex selector (read-only): aged .txt files with "Transcript" in the title that are linked to a Meeting Artifact, oldest first, up to MaxFilesPerRun. Pages through candidates so unrelated files cannot block it.</description>
        <name>Select_Transcripts</name>
        <label>Select Transcripts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>TranscriptRetentionSelector</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Is_Dry_Run</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Store_Fault_Message</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>maxFiles</name>
            <value>
                <elementReference>Get_Retention_Settings.MaxFilesPerRun__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>retentionDays</name>
            <value>
                <elementReference>Get_Retention_Settings.RetentionDays__c</elementReference>
            </value>
        </inputParameters>
        <nameSegment>TranscriptRetentionSelector</nameSegment>
        <outputParameters>
            <assignToReference>filesToDelete</assignToReference>
            <name>documents</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>counter</assignToReference>
            <name>selectedCount</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>scannedCount</assignToReference>
            <name>scannedCount</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>fileList</assignToReference>
            <name>fileList</name>
        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_Summary_Email</name>
        <label>Send Summary Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <faultConnector>
            <targetReference>Store_Email_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Retention_Settings.NotificationEmail__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Transcript retention run</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>Email_Body_Template</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <assignments>
        <description>Captures a selection or Delete Records fault so it is reported in the summary. Nothing is deleted after a selection fault.</description>
        <name>Store_Fault_Message</name>
        <label>Store Fault Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Email_Configured</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Captures an email failure so it does not fail the run (deletions are kept).</description>
        <name>Store_Email_Fault</name>
        <label>Store Email Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Stops unless the Default setting exists, is active and has positive retention days and cap.</description>
        <name>Is_Active</name>
        <label>Is Active</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Inactive or Invalid</defaultConnectorLabel>
        <rules>
            <name>Setting_Is_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Retention_Settings</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Retention_Settings.IsActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Retention_Settings.RetentionDays__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Retention_Settings.MaxFilesPerRun__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Select_Transcripts</targetReference>
            </connector>
            <label>Setting Is Active</label>
        </rules>
    </decisions>
    <decisions>
        <description>Deletes only when DryRun is off and at least one file was selected.</description>
        <name>Is_Dry_Run</name>
        <label>Is Dry Run</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Email_Configured</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Dry Run or No Files</defaultConnectorLabel>
        <rules>
            <name>Execute_Deletion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Retention_Settings.DryRun__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>counter</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Transcripts</targetReference>
            </connector>
            <label>Execute Deletion</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Email_Configured</name>
        <label>Check Email Configured</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Email Configured</defaultConnectorLabel>
        <rules>
            <name>Email_Is_Configured</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Retention_Settings.NotificationEmail__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Summary_Email</targetReference>
            </connector>
            <label>Email Is Configured</label>
        </rules>
    </decisions>
    <description>Transcript retention. The Apex action TranscriptRetentionSelector picks aged .txt files whose title contains "Transcript" and that are linked to a Meeting_Artifact__c (up to MaxFilesPerRun, oldest first); the flow then deletes them, or only reports them in dry run. Controlled by Transcript_Retention_Setting__mdt.Default. Deletes the whole file, including links to other records.</description>
    <environments>Default</environments>
    <interviewLabel>Advisor Assistant - Transcript Retention {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Advisor Assistant - Transcript Retention</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_Transcripts</name>
        <label>Delete Transcripts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Email_Configured</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Store_Fault_Message</targetReference>
        </faultConnector>
        <inputReference>filesToDelete</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_Retention_Settings</name>
        <label>Get Retention Settings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Active</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Transcript_Retention_Setting__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>IsActive__c</queriedFields>
        <queriedFields>DryRun__c</queriedFields>
        <queriedFields>RetentionDays__c</queriedFields>
        <queriedFields>MaxFilesPerRun__c</queriedFields>
        <queriedFields>NotificationEmail__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Retention_Settings</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-24</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>Email_Body_Template</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong&gt;Transcript Retention Run Summary&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Dry run:&lt;/strong&gt; {!Get_Retention_Settings.DryRun__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Files scanned:&lt;/strong&gt; {!scannedCount}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Files selected (Meeting Artifact transcripts):&lt;/strong&gt; {!counter}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Error message:&lt;/strong&gt; {!errorMessage}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;File list:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!fileList}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>counter</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>fileList</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>filesToDelete</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentDocument</objectType>
    </variables>
    <variables>
        <name>scannedCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
