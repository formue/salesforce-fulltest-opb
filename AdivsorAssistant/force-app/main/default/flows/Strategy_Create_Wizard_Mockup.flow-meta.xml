<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description
  >Hosts c:strategyWizard so the full five-step Create Strategy journey can be reviewed in a real flow runtime. The Custodian step is live; the other four steps are mocked and nothing is written back.</description>
    <environments>Default</environments>
    <interviewLabel
  >Strategy - SCR - Create Wizard (mockup) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Strategy - SCR - Create Wizard (mockup)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Create_Strategy</name>
        <label>Create Strategy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>strategyWizard</name>
            <extensionName>c:strategyWizard</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>countryCode</name>
                <value>
                    <elementReference>countryCode</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>uiStyle</name>
                <value>
                    <elementReference>uiStyle</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>showStyleToggle</name>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn
      >UseStoredValues</inputsOnNextNavToAssocScrn>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <!-- The wizard draws its own path indicator and navigation. -->
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Strategy</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <description
    >Record the flow was launched from. Carried through, not written to.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>uiStyle</name>
        <description
    >Which treatment to open with: classic or cockpit. The in-screen switch can change it afterwards.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>classic</stringValue>
        </value>
    </variables>
    <variables>
        <name>countryCode</name>
        <description
    >ISO country code of the customer, e.g. NO, SE or DK. Defaults to NO for debugging.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>NO</stringValue>
        </value>
    </variables>
</Flow>
