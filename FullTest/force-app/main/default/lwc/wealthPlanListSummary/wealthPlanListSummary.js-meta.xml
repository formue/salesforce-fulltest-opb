            <property name="goals" type="@salesforce/schema/FinServ__FinancialGoal__c[]" label="Goals Collection" />
            <property name="income" type="@salesforce/schema/FF_Income__c[]" label="Income Collection" />
            <property name="assets" type="@salesforce/schema/FinServ__AssetsAndLiabilities__c[]" label="Assets/Liabilities Collection" />
            <property name="milestones" type="@salesforce/schema/Household_Milestones__c[]" label="Milestones Collection" />
            <property name="ownership" type="@salesforce/schema/Company_Ownership__c[]" label="Ownership Collection" />
