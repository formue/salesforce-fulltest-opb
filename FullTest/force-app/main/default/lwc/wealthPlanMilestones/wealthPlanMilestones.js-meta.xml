<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Wealth Plan: Milestones Editor</masterLabel>
    <description>Premium SPA component for managing Household Milestones.</description>
    <targets><target>lightning__FlowScreen</target></targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- INPUTS -->
            <property name="recordId" type="String" label="0. Input: Record ID" role="inputOnly"/>
            <property name="inputMilestones" type="@salesforce/schema/Household_Milestones__c[]" label="1. Input: Milestones Collection" role="inputOnly"/>
            <property name="inputHouseholds" type="@salesforce/schema/Account[]" label="2. Input: Households Collection" role="inputOnly"/>
            <property name="inputDefaultHouseholdId" type="String" label="3. Input: Default Household ID" role="inputOnly" description="Automatically maps to RelatedHousehold__c when adding a new record."/>
            
            <property name="backgroundColor" type="String" label="4. Style: Background Color" default="#f0f9ff" role="inputOnly"/>
            <property name="inputIsPublished" type="Boolean" label="5. Input: Is Published" role="inputOnly"/>
            
            <!-- DISPLAY CONTROLS -->
            <property name="rowsPerPage" type="Integer" label="6. Display: Rows Per Page" default="5" role="inputOnly" description="Number of records to show in the table before paginating."/>
            <property name="visibleLines" type="Integer" label="7. Display: Visible Text Lines" default="3" role="inputOnly" description="Number of lines to show in the grid text boxes before adding a scrollbar."/>

            <!-- AI MODULE INPUTS -->
            <property name="showAiSection" type="Boolean" label="8. AI: Show AI Accordion Module?" default="false" role="inputOnly"/>
            <property name="defaultAccordionOpen" type="Boolean" label="8b. AI: Default Accordion Open?" default="false" role="inputOnly"/>
            <property name="isAiLoading" type="Boolean" label="9. AI: Show Loading Animation?" default="false" role="inputOnly"/>
            <property name="aiInsightSummary" type="String" label="10. AI: Formatted HTML Summary" role="inputOnly"/>

            <!-- OUTPUTS -->
            <property name="outputMilestones" type="@salesforce/schema/Household_Milestones__c[]" label="Output: Milestones (Save/Update)" role="outputOnly"/>
            <property name="outputMilestonesToDelete" type="@salesforce/schema/Household_Milestones__c[]" label="Output: Milestones (Delete)" role="outputOnly"/>
            <property name="outputAction" type="String" label="Output: Action" role="outputOnly"/>
            <property name="outputIsPublished" type="Boolean" label="Output: Is Published" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>