<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Wealth Plan: Print Hub</masterLabel>
    <description>Modernized Document Engine Dashboard for generating the final Wealth Plan PDF without loading heavy nested accordions.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        
        <!-- ========================================== -->
        <!-- RECORD PAGE CONFIGURATION                  -->
        <!-- (Salesforce strictly forbids 'role' here)  -->
        <!-- ========================================== -->
        <targetConfig targets="lightning__RecordPage">
            <property name="recordId" type="String" label="Input: Context Record ID" />
            <property name="householdId" type="String" label="Input: Household ID" description="The Context ID required for the print engine." />
            <property name="backgroundColor" type="String" label="Style: Background Color" default="#f0f9ff" />
            
            <property name="householdMembers" type="String" label="[LEGACY] Input: Household Members" description="Do not use." />
            <property name="householdBusinessMembers" type="String" label="[LEGACY] Input: Business Members" description="Do not use." />
            <property name="householdPrimaryMember" type="String" label="[LEGACY] Input: Primary Member" description="Do not use." />
            <property name="householdSelectedMember" type="String" label="[LEGACY] Input: Selected Member" description="Do not use." />
        </targetConfig>

        <!-- ========================================== -->
        <!-- FLOW SCREEN CONFIGURATION                  -->
        <!-- (Roles are required/recommended here)      -->
        <!-- ========================================== -->
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Input: Context Record ID" role="inputOnly" />
            <property name="householdId" type="String" label="Input: Household ID" description="The Context ID required for the print engine." role="inputOnly" />
            <property name="backgroundColor" type="String" label="Style: Background Color" default="#f0f9ff" role="inputOnly" />
            
            <!-- DYNAMIC RECORD COLLECTIONS FOR PRE-FLIGHT CHECKLIST -->
            <property name="inputGoals" type="@salesforce/schema/FinServ__FinancialGoal__c[]" label="Setup: Goals Collection" role="inputOnly" />
            <property name="inputIncomes" type="@salesforce/schema/FF_Income__c[]" label="Setup: Incomes Collection" role="inputOnly" />
            <property name="inputAssets" type="@salesforce/schema/FinServ__AssetsAndLiabilities__c[]" label="Setup: Assets Collection" role="inputOnly" />
            <property name="inputMilestones" type="@salesforce/schema/Household_Milestones__c[]" label="Setup: Milestones Collection" role="inputOnly" />
            <property name="inputOwnerships" type="@salesforce/schema/Company_Ownership__c[]" label="Setup: Company Ownerships" role="inputOnly" />
            <property name="inputGreetings" type="@salesforce/schema/FF_PersonalGreeting__c[]" label="Setup: Personal Greetings" role="inputOnly" />
            <property name="inputSustainability" type="@salesforce/schema/SustainabilityPreferences__c[]" label="Setup: Sustainability Prefs" role="inputOnly" />
            <property name="inputCapitalNeeds" type="@salesforce/schema/CapitalNeeds__c[]" label="Setup: Capital Needs Collection" role="inputOnly" />
            <property name="inputCapitalNeedsSummary" type="@salesforce/schema/CapitalNeedsSummary__c" label="Setup: Capital Needs Summary (Risk/Lock-In)" role="inputOnly" />
            <property name="inputInvestmentStrategies" type="@salesforce/schema/InvestmentStrategy__c[]" label="Setup: Investment Strategies" role="inputOnly" />

            <property name="householdMembers" type="String" label="[LEGACY] Input: Household Members" description="Do not use. Kept to prevent deployment errors from older flow/page versions." role="inputOnly" />
            <property name="householdBusinessMembers" type="String" label="[LEGACY] Input: Business Members" description="Do not use. Kept to prevent deployment errors from older flow/page versions." role="inputOnly" />
            <property name="householdPrimaryMember" type="String" label="[LEGACY] Input: Primary Member" description="Do not use. Kept to prevent deployment errors from older flow/page versions." role="inputOnly" />
            <property name="householdSelectedMember" type="String" label="[LEGACY] Input: Selected Member" description="Do not use. Kept to prevent deployment errors from older flow/page versions." role="inputOnly" />
        </targetConfig>

    </targetConfigs>
</LightningComponentBundle>