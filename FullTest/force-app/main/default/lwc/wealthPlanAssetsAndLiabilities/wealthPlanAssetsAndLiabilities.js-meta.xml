<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Wealth Plan: Assets Editor</masterLabel>
    <description>Premium SPA component for managing Assets and Liabilities. Built on the unified Rubicon Blueprint.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="0. Input: Record ID" role="inputOnly" description="The Context ID."/>
            <property name="inputAssets" type="@salesforce/schema/FinServ__AssetsAndLiabilities__c[]" label="1. Input: Assets Collection" role="inputOnly"/>
            <property name="inputHouseholdMembers" type="@salesforce/schema/Account[]" label="2. Input: Household Members Collection" role="inputOnly"/>
            <property name="inputBusinessAccounts" type="@salesforce/schema/Account[]" label="2b. Input: Business Accounts Collection" role="inputOnly"/>
            <property name="inputPrimaryMemberId" type="String" label="3. Input: Default Primary Member ID" role="inputOnly"/>
            <property name="backgroundColor" type="String" label="4. Style: Background Color" default="#f0f9ff" role="inputOnly"/>
            
            <property name="rowsPerPage" type="Integer" label="4b. Display: Visible Rows" default="5" role="inputOnly"/>
            
            <property name="inputIsPublished" type="Boolean" label="5. Input: Is Plan Published?" default="false" role="inputOnly"/>
            <property name="isBusinessContext" type="Boolean" label="5b. Context: Is Business Account?" default="false" role="inputOnly"/>
            
            <property name="showAiSection" type="Boolean" label="6. AI: Show AI Accordion Module?" default="false" role="inputOnly"/>
            <property name="defaultAccordionOpen" type="Boolean" label="6b. AI: Default Accordion Open?" default="false" role="inputOnly"/>
            <property name="isAiLoading" type="Boolean" label="7. AI: Show Loading Animation?" default="false" role="inputOnly"/>
            <property name="aiInsightSummary" type="String" label="8. AI: Formatted HTML Summary" role="inputOnly"/>
            
            <property name="outputAction" type="String" label="Output: Action (SAVE)" role="outputOnly"/>
            <property name="outputIsPublished" type="Boolean" label="Output: Is Published" role="outputOnly"/>
            <property name="outputAssets" type="@salesforce/schema/FinServ__AssetsAndLiabilities__c[]" label="Output: Assets (To Save)" role="outputOnly"/>
            <property name="outputAssetsToDelete" type="@salesforce/schema/FinServ__AssetsAndLiabilities__c[]" label="Output: Assets (To DELETE)" role="outputOnly"/>
            
            <property name="outputAiContext" type="String" label="Output: AI Context (Rosetta Stone)" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>