<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Wealth Plan: Company Ownership Editor</masterLabel>
    <description>Premium SPA component for managing Company Ownership.</description>
    <targets><target>lightning__FlowScreen</target></targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- INPUTS -->
            <property name="recordId" type="String" label="0. Input: Record ID" role="inputOnly"/>
            <property name="inputOwnerships" type="@salesforce/schema/Company_Ownership__c[]" label="1. Input: Ownership Records" role="inputOnly"/>
            
            <property name="inputCompanies" type="@salesforce/schema/Account[]" label="2. Input: Companies (Business Accounts)" role="inputOnly" description="Collection for 'Company Owned' and 'Company Owner' lookups."/>
            <property name="inputPersons" type="@salesforce/schema/Account[]" label="3. Input: Persons (Household Members)" role="inputOnly" description="Collection for 'Company Owner' lookups."/>
            
            <property name="backgroundColor" type="String" label="4. Style: Background Color" default="#f0f9ff" role="inputOnly"/>
            <property name="inputIsPublished" type="Boolean" label="5. Input: Is Plan Published?" role="inputOnly"/>
            
            <!-- DISPLAY CONTROLS -->
            <property name="rowsPerPage" type="Integer" label="6. Display: Rows Per Page" default="5" role="inputOnly"/>
            <property name="visibleLines" type="Integer" label="7. Display: Visible Text Lines" default="3" role="inputOnly"/>

            <!-- AI MODULE INPUTS -->
            <property name="showAiSection" type="Boolean" label="8. AI: Show AI Accordion Module?" default="false" role="inputOnly"/>
            <property name="defaultAccordionOpen" type="Boolean" label="8b. AI: Default Accordion Open?" default="false" role="inputOnly"/>
            <property name="isAiLoading" type="Boolean" label="9. AI: Show Loading Animation?" default="false" role="inputOnly"/>
            <property name="aiInsightSummary" type="String" label="10. AI: Formatted HTML Summary" role="inputOnly"/>

            <!-- LEGACY INPUTS (DO NOT REMOVE, PREVENTS FLOW CRASH) -->
            <property name="inputEntities" type="@salesforce/schema/Account[]" label="Legacy: Input Entities" role="inputOnly"/>
            <property name="inputCompanyOwnedField" type="String" label="Legacy: Company Owned Field" role="inputOnly"/>
            <property name="inputCompanyOwnerField" type="String" label="Legacy: Company Owner Field" role="inputOnly"/>

            <!-- CLEANED UP OUTPUTS -->
            <property name="outputOwnershipsToUpsert" type="@salesforce/schema/Company_Ownership__c[]" label="Output: Records to Upsert (Create and Update)" role="outputOnly" description="Contains both new and edited records. New records have an Id starting with 'NEW_'."/>
            <property name="outputOwnershipsToDelete" type="@salesforce/schema/Company_Ownership__c[]" label="Output: Records to Delete" role="outputOnly" description="Records flagged for deletion. Pass directly to a Delete Records element."/>
            
            <!-- JSON STRING OUTPUTS (CRASH PROOF) -->
            <property name="outputUpsertJSON" type="String" label="Output: Upsert (JSON String)" role="outputOnly" description="Plain text JSON string of records to create/update. Unbreakable in Flow."/>
            <property name="outputDeleteJSON" type="String" label="Output: Delete (JSON String)" role="outputOnly" description="Plain text JSON string of records to delete. Unbreakable in Flow."/>
            
            <!-- LEGACY OUTPUTS (DO NOT REMOVE, PREVENTS FLOW CRASH) -->
            <property name="outputRecordsToCreate" type="@salesforce/schema/Company_Ownership__c[]" label="Legacy: Records to Create" role="outputOnly"/>
            <property name="outputRecordsToUpdate" type="@salesforce/schema/Company_Ownership__c[]" label="Legacy: Records to Update" role="outputOnly"/>
            <property name="outputRecordsToDelete" type="@salesforce/schema/Company_Ownership__c[]" label="Legacy: Records to Delete" role="outputOnly"/>
            <property name="outputCreateJSON" type="String" label="Legacy: Create JSON" role="outputOnly"/>
            <property name="outputUpdateJSON" type="String" label="Legacy: Update JSON" role="outputOnly"/>
            <property name="outputOwnerships" type="@salesforce/schema/Company_Ownership__c[]" label="Legacy: Output Ownerships" role="outputOnly"/>

            <property name="outputAction" type="String" label="Output: Action" role="outputOnly"/>
            <property name="outputIsPublished" type="Boolean" label="Output: Is Published" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>