<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Wealth Plan: Sustainability Preferences</masterLabel>
    <description>Premium SPA component for managing ESG and Sustainability profiles with Dependent Picklists and Template Injection.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- INPUTS -->
            <property name="recordId" type="String" label="0. Input: Record ID" role="inputOnly" />
            <property name="inputRecords" type="@salesforce/schema/SustainabilityPreferences__c[]" label="1. Input: Preferences Collection" role="inputOnly"/>
            <property name="backgroundColor" type="String" label="2. Style: Background Color" default="#f0f9ff" role="inputOnly"/>
            <property name="inputIsPublished" type="Boolean" label="3. Input: Is Plan Published?" default="false" role="inputOnly"/>
            
            <property name="rowsPerPage" type="Integer" label="4a. Display: Visible Rows" default="5" role="inputOnly"/>
            
            <!-- MODAL EDITOR CONTROLS -->
            <property name="useModalForEditor" type="Boolean" label="4d. UI: Open Editor in Modal?" default="false" role="inputOnly" description="If true, the editor opens in a beautiful overlay modal instead of replacing the entire dashboard view."/>
            <property name="editorModalWidth" type="String" label="4e. UI: Editor Modal Width" default="1000px" role="inputOnly" description="Set the width of the modal (e.g., '800px', '1000px', '80%'). Only applies if 'Open Editor in Modal' is true."/>

            <!-- DASHBOARD AI MODULE INPUTS -->
            <property name="showAiSection" type="Boolean" label="5. AI: Show Dashboard AI Accordion?" default="false" role="inputOnly"/>
            <property name="defaultAccordionOpen" type="Boolean" label="5b. AI: Default Dashboard Accordion Open?" default="false" role="inputOnly"/>
            <property name="isAiLoading" type="Boolean" label="6. AI: Show Dashboard Loading Animation?" default="false" role="inputOnly"/>
            <property name="aiInsightSummary" type="String" label="7. AI: Dashboard Insight HTML" role="inputOnly"/>
            
            <!-- TEMPLATE INPUTS -->
            <property name="templateEnglish" type="String" label="8a. Template: English Text" role="inputOnly" description="Pre-defined English text from Custom Metadata to inject into comments."/>
            <property name="templateLocal" type="String" label="8b. Template: Local Language Text" role="inputOnly" description="Pre-defined local text from Custom Metadata to inject into comments."/>
            <property name="localLanguageCode" type="String" label="8c. Template: Local Language Button Label" default="NO" role="inputOnly" description="E.g., NO, SE, DK"/>

            <!-- OUTPUTS -->
            <property name="outputAction" type="String" label="Output: Action (SAVE)" role="outputOnly"/>
            <property name="outputIsPublished" type="Boolean" label="Output: Is Published" role="outputOnly"/>
            <property name="outputRecords" type="@salesforce/schema/SustainabilityPreferences__c[]" label="Output: Preferences (To Save)" role="outputOnly"/>
            <property name="outputRecordsToDelete" type="@salesforce/schema/SustainabilityPreferences__c[]" label="Output: Preferences (To DELETE)" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>